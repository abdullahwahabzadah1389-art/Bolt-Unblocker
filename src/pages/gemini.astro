---
import Layout from "../Layouts/Layout.astro";
---

<Layout title="Gemini Chat">
    <main id="gem-page">
        <!-- Ambient glow -->
        <div id="gem-glow"></div>

        <!-- Header -->
        <header id="gem-header" class="glass-panel">
            <div id="gem-header-info">
                <div id="gem-badge">
                    <svg
                        width="15"
                        height="15"
                        viewBox="0 0 24 24"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <path
                            d="M12 2L13.8 9.2L21 11L13.8 12.8L12 20L10.2 12.8L3 11L10.2 9.2L12 2Z"
                            fill="currentColor"></path>
                    </svg>
                    <span id="gem-title">Gemini Chat</span>
                </div>
                <div id="gem-model-badge">
                    <span id="gem-model-name">gemini-3.8-flash</span>
                </div>
                <div id="gem-key-status" title="No API key saved">
                    <span class="gem-dot"></span>
                    <span class="gem-key-label">No key</span>
                </div>
            </div>
            <div id="gem-header-actions">
                <button
                    class="gem-header-btn"
                    id="gem-clear-btn"
                    title="Clear chat"
                    aria-label="Clear chat"
                >
                    <svg
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <path
                            d="M3 6H21M8 6V4H16V6M19 6L18.1 19.1C18.0469 19.9206 17.3777 20.5556 16.555 20.5556H7.445C6.62228 20.5556 5.95313 19.9206 5.9 19.1L5 6"
                            stroke="currentColor"
                            stroke-width="1.8"
                            stroke-linecap="round"
                            stroke-linejoin="round"></path>
                    </svg>
                </button>
                <button
                    class="gem-header-btn"
                    id="gem-settings-btn"
                    title="Settings"
                    aria-label="Settings"
                >
                    <svg
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <path
                            d="M12 15C13.6569 15 15 13.6569 15 12C15 10.3431 13.6569 9 12 9C10.3431 9 9 10.3431 9 12C9 13.6569 10.3431 15 12 15Z"
                            stroke="currentColor"
                            stroke-width="1.8"></path>
                        <path
                            d="M19.4 15C19.2669 15.3024 19.2272 15.6362 19.286 15.9606C19.3448 16.285 19.4995 16.5853 19.73 16.82L19.79 16.88C19.9661 17.0565 20.1059 17.2661 20.2008 17.4981C20.2957 17.73 20.3439 17.9802 20.3424 18.233C20.3408 18.4857 20.2894 18.7353 20.1918 18.9659C20.0942 19.1965 19.9523 19.4039 19.7746 19.5763C19.597 19.7487 19.3871 19.8823 19.1582 19.9695C18.9293 20.0567 18.6865 20.0958 18.4437 20.0843H18.33C18.0659 20.0693 17.8083 19.9975 17.579 19.8746C17.3497 19.7517 17.1547 19.581 17.007 19.3751C16.8594 19.1692 16.7628 18.9334 16.7246 18.6861C16.6864 18.4388 16.7075 18.1859 16.786 17.948L16.84 17.79C16.9526 17.4597 16.9353 17.0983 16.7909 16.781C16.6465 16.4636 16.3847 16.2128 16.06 16.08C15.7453 15.9488 15.3946 15.9427 15.076 16.0627C14.7574 16.1827 14.4922 16.4208 14.33 16.73L14.25 16.88C14.0814 17.1925 13.8035 17.4349 13.4682 17.5638C13.1328 17.6927 12.7602 17.6996 12.42 17.583C12.0905 17.4705 11.8093 17.2528 11.6186 16.964C11.4279 16.6752 11.3376 16.3303 11.36 15.985V15.87C11.3786 15.5318 11.2719 15.1977 11.06 14.93C10.8481 14.6623 10.5443 14.4773 10.205 14.406C9.86577 14.3347 9.51145 14.3822 9.20447 14.5407C8.89748 14.6992 8.65634 14.9589 8.52 15.27L8.44 15.44C8.23932 15.8517 7.88397 16.1644 7.45691 16.2994C7.02985 16.4344 6.56734 16.3798 6.18 16.15C5.87166 15.9683 5.63362 15.6869 5.50367 15.3508C5.37373 15.0148 5.35919 14.645 5.462 14.3L5.52 14.11C5.67455 13.6229 5.98765 13.2052 6.41 12.93C6.83235 12.6548 7.34028 12.5423 7.83 12.61H8C8.33192 12.6373 8.61756 12.8394 8.77 13.13C8.87451 13.3378 9.03937 13.5085 9.24459 13.6236C9.44982 13.7387 9.68689 13.7936 9.925 13.781H10.06C10.3914 13.7653 10.7035 13.6219 10.93 13.38C11.1565 13.1381 11.2812 12.8139 11.28 12.475V12.35C11.2631 12.0224 11.3621 11.7009 11.5599 11.4424C11.7578 11.1839 12.0423 11.0025 12.365 10.928C12.6877 10.8535 13.0289 10.8912 13.3273 11.0347C13.6257 11.1782 13.8629 11.419 14 11.71V11.83C14 12.1553 14.1293 12.4696 14.3588 12.6991C14.5882 12.9287 14.9024 13.058 15.2275 13.058H15.38C15.7243 13.0563 16.0545 12.9204 16.2984 12.6818C16.5422 12.4433 16.6804 12.1199 16.68 11.78V11.67C16.6851 11.3336 16.8189 11.0135 17.0523 10.7801C17.2857 10.5467 17.6058 10.4129 17.9422 10.4078C18.2786 10.4027 18.6027 10.5165 18.8535 10.7281C19.1043 10.9397 19.2651 11.2341 19.305 11.555L19.35 11.73C19.4339 12.0988 19.6216 12.4335 19.89 12.69C20.1584 12.9465 20.4972 13.1126 20.86 13.16H21C21.3523 13.1663 21.6917 13.2947 21.96 13.525C22.2283 13.7553 22.4114 14.0749 22.48 14.43"
                            stroke="currentColor"
                            stroke-width="1.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"></path>
                    </svg>
                </button>
            </div>
        </header>

        <!-- Settings panel -->
        <section id="gem-settings" class="glass-panel" hidden>
            <div id="gem-settings-header">
                <span id="gem-settings-title">Settings</span>
                <button
                    id="gem-settings-close"
                    aria-label="Close settings"
                    title="Close"
                >
                    <svg
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <path
                            d="M18 6L6 18M6 6L18 18"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"></path>
                    </svg>
                </button>
            </div>

            <div id="gem-settings-body">
                <div class="gem-field">
                    <label for="gem-api-key">Gemini API Key</label>
                    <div id="gem-key-row">
                        <input
                            type="password"
                            id="gem-api-key"
                            placeholder="Paste your API key (AIza...)"
                            autocomplete="off"
                            spellcheck="false"
                        />
                        <button
                            id="gem-key-reveal"
                            title="Show / hide key"
                            aria-label="Show or hide key"
                        >
                            <svg
                                width="15"
                                height="15"
                                viewBox="0 0 24 24"
                                fill="none"
                                xmlns="http://www.w3.org/2000/svg"
                            >
                                <path
                                    d="M1 12C1 12 5 4 12 4C19 4 23 12 23 12C23 12 19 20 12 20C5 20 1 12 1 12Z"
                                    stroke="currentColor"
                                    stroke-width="1.8"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"></path>
                                <path
                                    d="M12 15C13.6569 15 15 13.6569 15 12C15 10.3431 13.6569 9 12 9C10.3431 9 9 10.3431 9 12C9 13.6569 10.3431 15 12 15Z"
                                    stroke="currentColor"
                                    stroke-width="1.8"></path>
                            </svg>
                        </button>
                    </div>
                    <p class="gem-hint">
                        Your key is stored only in this browser's localStorage
                        and is sent directly to Google — never to Bolt's
                        servers. Get one at <a
                            href="https://aistudio.google.com/apikey"
                            target="_blank"
                            rel="noopener noreferrer">aistudio.google.com/apikey"
                        ></a>
                    </p>
                </div>

                <div class="gem-field">
                    <label for="gem-model-select">Model</label>
                    <select id="gem-model-select">
                        <option value="gemini-3.8-flash">gemini-3.8-flash</option
                        >
                        <option value="gemini-3.6-flash">gemini-3.6-flash</option
                        >
                        <option value="gemini-3.5-flash-lite"
                            >gemini-3.5-flash-lite</option
                        >
                        <option value="gemini-2.5-flash">gemini-2.5-flash</option
                        >
                    </select>
                    <p class="gem-hint">
                        Flash models are available on the free API tier. If a
                        model rejects your key, pick another one.
                    </p>
                </div>

                <div id="gem-settings-actions">
                    <button id="gem-save-btn" class="gem-action-btn primary"
                        >Save</button
                    >
                    <button id="gem-forget-btn" class="gem-action-btn danger"
                        >Forget key</button
                    >
                </div>
                <p id="gem-settings-feedback" aria-live="polite"></p>
            </div>
        </section>

        <!-- Messages -->
        <div id="gem-messages-container">
            <div id="gem-messages">
                <!-- Welcome state -->
                <div id="gem-welcome">
                    <div id="gem-welcome-icon">
                        <svg
                            width="34"
                            height="34"
                            viewBox="0 0 24 24"
                            fill="none"
                            xmlns="http://www.w3.org/2000/svg"
                        >
                            <path
                                d="M12 2L13.8 9.2L21 11L13.8 12.8L12 20L10.2 12.8L3 11L10.2 9.2L12 2Z"
                                fill="currentColor"></path>
                        </svg>
                    </div>
                    <h1 id="gem-welcome-title">Gemini, inside Bolt</h1>
                    <p id="gem-welcome-subtitle">
                        Direct access to Google's Gemini API — no login page,
                        just your API key.
                    </p>
                    <div id="gem-chips">
                        <button
                            class="gem-chip"
                            data-prompt="Explain quantum computing like I'm 12"
                            >Explain quantum computing</button
                        >
                        <button
                            class="gem-chip"
                            data-prompt="Write a short poem about the ocean"
                            >Write a poem</button
                        >
                        <button
                            class="gem-chip"
                            data-prompt="Help me debug my JavaScript code"
                            >Debug my code</button
                        >
                        <button
                            class="gem-chip"
                            data-prompt="Summarize the history of the internet"
                            >History of the internet</button
                        >
                    </div>
                </div>

                <!-- Thinking indicator -->
                <div
                    id="gem-thinking"
                    class="gem-message model"
                    aria-hidden="true"
                >
                    <div class="gem-avatar">
                        <svg
                            width="14"
                            height="14"
                            viewBox="0 0 24 24"
                            fill="none"
                            xmlns="http://www.w3.org/2000/svg"
                        >
                            <path
                                d="M12 2L13.8 9.2L21 11L13.8 12.8L12 20L10.2 12.8L3 11L10.2 9.2L12 2Z"
                                fill="currentColor"></path>
                        </svg>
                    </div>
                    <div class="gem-msg-body">
                        <div class="gem-bubble gem-thinking-bubble">
                            <span class="dot"></span><span class="dot"
                            ></span><span class="dot"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Input bar -->
        <div id="gem-input-wrapper">
            <div id="gem-input-panel" class="glass-panel">
                <textarea
                    id="gem-input"
                    placeholder="Message Gemini..."
                    rows="1"
                    aria-label="Message input"></textarea>
                <button
                    id="gem-stop-btn"
                    class="gem-input-btn"
                    title="Stop generating"
                    aria-label="Stop generating"
                    hidden
                >
                    <svg
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <rect x="6" y="6" width="12" height="12" rx="2"
                        ></rect>
                    </svg>
                </button>
                <button
                    id="gem-send-btn"
                    class="gem-input-btn"
                    title="Send"
                    aria-label="Send message"
                    disabled
                >
                    <svg
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <path
                            d="M12 19V5M5 12L12 5L19 12"
                            stroke="currentColor"
                            stroke-width="2.2"
                            stroke-linecap="round"
                            stroke-linejoin="round"></path>
                    </svg>
                </button>
            </div>
            <p id="gem-disclaimer">
                Responses come directly from Google's Gemini API. Gemini can
                make mistakes — verify important information.
            </p>
        </div>
    </main>

    <script src="../scripts/gemini.ts"></script>
</Layout>

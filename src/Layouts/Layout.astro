---
import "../styles/global.css";
export interface Props {
    title: string;
    proxy?: boolean;
}
const { title, proxy = false } = Astro.props;
---

<!doctype html>
<html lang="en" style="scroll-behavior: smooth; overflow-x: hidden;">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/img/bolt.ico" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        {
            proxy && (
                <>
                    <script is:inline src="/baremux/index.js" />
                    <script is:inline src="/learn/scramjet.all.js" />
                    <script src="../scripts/proxy.ts" />
                </>
            )
        }

        <!-- Google tag (gtag.js) -->
        <script
            async
            src="https://www.googletagmanager.com/gtag/js?id=G-QKPZDPQGCR"
        ></script>
        <script lang="js">
            window.dataLayer = window.dataLayer || [];
            function gtag() {
                dataLayer.push(arguments);
            }
            gtag("js", new Date());

            gtag("config", "G-QKPZDPQGCR");
        </script>
    </head>

    <body>        <slot />
    </body>
</html>
